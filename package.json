{
  "name": "aws-ai-assistant-chrome-extension",
  "version": "1.0.0",
  "description": "Amazon Bedrock 기반 Chrome Extension",
  "main": "src/background/background.js",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:e2e": "jest tests/e2e",
    "build": "webpack --mode production",
    "dev": "webpack --mode development --watch",
    "serve": "http-server -p 3000 -c-1 --cors",
    "dev:serve": "concurrently \"npm run dev\" \"npm run serve\"",
    "lint": "eslint src/ tests/",
    "validate-structure": "node tests/validate-structure.js"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.1",
    "concurrently": "^8.2.2",
    "eslint": "^8.45.0",
    "http-server": "^14.1.1",
    "jest": "^27.5.1",
    "jest-chrome": "^0.8.0",
    "jest-environment-jsdom": "^27.5.1",
    "node-fetch": "^2.7.0",
    "puppeteer": "^21.0.0",
    "webpack": "^5.88.0",
    "webpack-cli": "^5.1.0"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/assets/**",
      "!src/**/*.test.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 70,
        "functions": 70,
        "lines": 70,
        "statements": 70
      }
    }
  }
}
