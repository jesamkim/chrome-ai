{
  "manifest_version": 3,
  "name": "AWS AI Assistant",
  "version": "2.0.1",
  "description": "Amazon Bedrock 기반 Side Panel AI 어시스턴트 - 채팅 히스토리 저장, 세션 관리",
  
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "contextMenus",
    "tabs",
    "sidePanel"
  ],
  
  "host_permissions": [
    "https://bedrock-runtime.us-west-2.amazonaws.com/*",
    "<all_urls>"
  ],
  
  "background": {
    "service_worker": "src/background/background.js"
  },
  
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": [
      "src/content/enhanced-text-extractor.js",
      "src/content/content.js"
    ],
    "css": ["src/content/content.css"],
    "run_at": "document_idle",
    "all_frames": false
  }],
  
  "action": {
    "default_title": "AWS AI Assistant"
  },

  "side_panel": {
    "default_path": "src/sidepanel/sidepanel.html"
  },
  
  "options_page": "src/options/options.html",
  
  "icons": {
    "16": "src/assets/icons/icon16.png",
    "48": "src/assets/icons/icon48.png",
    "128": "src/assets/icons/icon128.png"
  },

  "web_accessible_resources": [{
    "resources": ["src/sidebar/*", "src/content/*"],
    "matches": ["<all_urls>"]
  }]
}
